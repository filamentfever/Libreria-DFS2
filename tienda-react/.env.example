# URL base del backend.
# Por defecto el frontend usa el API Gateway en http://localhost:8080.
# El Gateway enruta:
#   /api/productos/** -> catálogo (8097)
#   /api/carritos/**  -> carrito  (8083)
#   /api/usuarios/**  -> usuarios (8081)
# Si no usas Gateway, puedes apuntar directo a un servicio, pero solo funcionará
# para las rutas de ese servicio.
VITE_API_URL=http://localhost:8080
